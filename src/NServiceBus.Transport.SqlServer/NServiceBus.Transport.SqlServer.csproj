<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <SignAssembly>true</SignAssembly>
    <AssemblyOriginatorKeyFile>..\NServiceBus.snk</AssemblyOriginatorKeyFile>
  </PropertyGroup>

  <PropertyGroup>
    <Description>SQL transport support for NServiceBus. This packages depends on Microsoft.Data.SqlClient.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.SqlClient" Version="6.1.5" AutomaticVersionRange="false" />
    <PackageReference Include="NServiceBus" Version="10.2.5" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Particular.Obsoletes" Version="1.1.0" PrivateAssets="All" ExcludeAssets="runtime" />
    <PackageReference Include="Particular.Packaging" Version="4.5.0" PrivateAssets="All" />
  </ItemGroup>

  <ItemGroup Label="Pinned Transitive Dependencies for CVEs">
    <!-- Pinned to 9.x because Microsoft.Data.SqlClient 6.1.x targets the 9.x line, even though repo-integrity expects framework packages to match the .NET 10 target framework.
         When this pin is removed or moved to 10.x, also remove the ComponentShouldTargetDotNetLtsVersion ignore in .repointegrity.yml. -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="9.0.21" AutomaticVersionRange="false" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\NServiceBus.Transport.Sql.Shared\**\*.cs" LinkBase="Shared" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="NServiceBus.Transport.SqlServer.AcceptanceTests" Key="$(NServiceBusTestsKey)" />
    <InternalsVisibleTo Include="NServiceBus.Transport.SqlServer.IntegrationTests" Key="$(NServiceBusTestsKey)" />
    <InternalsVisibleTo Include="NServiceBus.Transport.SqlServer.TransportTests" Key="$(NServiceBusTestsKey)" />
    <InternalsVisibleTo Include="NServiceBus.Transport.SqlServer.UnitTests" Key="$(NServiceBusTestsKey)" />
  </ItemGroup>

</Project>
